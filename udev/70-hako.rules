# Redragon M711-FPS-1 Cobra FPS
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="fc62", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="fc62", TAG+="uaccess"

# Redragon M901-K-2 Perdition
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="fc5e", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="04d9", ATTRS{idProduct}=="fc5e", TAG+="uaccess"

# Logitech HID++ devices not listed above
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# QMK / VIA keyboards: raw HID interface (usage page 0xFF60, usage 0x61).
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", PROGRAM="/bin/sh -c 'LC_ALL=C grep -qaP \"\x06\x60\xff\x09\x61\" /sys%p/device/report_descriptor'", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Host-side remaps and macros inject through uinput.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
