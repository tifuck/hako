# Repackages the release tarball for Arch (AUR name: hako-bin).
# On a new release: bump pkgver, then `updpkgsums` (or paste the tarball's line
# from the release's SHA256SUMS).
pkgname=hako-bin
pkgver=0.2.10
pkgrel=1
pkgdesc='Control panel for gaming keyboards, mice and headsets'
arch=('x86_64')
url='https://github.com/tifuck/hako'
license=('MIT')
# Linked: glibc, gcc-libs, libpipewire. The window system libraries are
# dlopened by winit / glutin, so they are listed by hand.
depends=('glibc' 'gcc-libs' 'pipewire' 'systemd' 'lsp-plugins-ladspa'
         'libglvnd' 'wayland' 'libxkbcommon' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
optdepends=('wireplumber: ChatMix and the mixer'
            'alsa-utils: line-in input jack and capture level')
provides=('hako')
conflicts=('hako')
install=hako.install
_dir="hako-${pkgver}-x86_64-linux"
source=("${url}/releases/download/v${pkgver}/${_dir}.tar.gz")
sha256sums=('c46290741f0c8fc2acae02909bf27072c66b4c10db9a3c71a77af52e83a8f56f')

package() {
  cd "$_dir"
  install -Dm755 bin/hako bin/hakod -t "$pkgdir/usr/bin/"
  sed 's|%h/.local/bin/hakod|/usr/bin/hakod|' packaging/systemd/hakod.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/hakod.service"
  install -Dm644 packaging/hako.desktop "$pkgdir/usr/share/applications/hako.desktop"
  install -Dm644 client/assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/hako.png"
  install -Dm644 udev/70-hako.rules "$pkgdir/usr/lib/udev/rules.d/70-hako.rules"
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
