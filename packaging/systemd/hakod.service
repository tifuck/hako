[Unit]
Description=hako device daemon
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service
# Enabled globally by the .deb: never for system accounts (e.g. the login
# screen's greeter user).
ConditionUser=!@system

[Service]
Type=simple
ExecStart=%h/.local/bin/hakod
# Ensure pactl/pw-link are found (user service has a minimal PATH)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2


[Install]
WantedBy=default.target
